# ---- Unity generated folders (rebuilt automatically by Unity) ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Android build intermediates
/.utmp/

# ---- Build output (APKs etc.) ----
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.unitypackage
*.app

# Gradle / Android Studio exports
.gradle/
/ExportedObj/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---- IDE / solution files (regenerated by Unity) ----
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crashlytics generated file
crashlytics-build.properties

# TextMesh Pro / addressables / burst generated
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
*_BurstDebugInformation_DoNotShip/

# ---- OS junk ----
.DS_Store
Thumbs.db
Desktop.ini

# Windows Explorer folder settings
desktop.ini
desktop.ini.meta
